{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opendata.geocode-address input",
  "type": "object",
  "required": ["address"],
  "additionalProperties": false,
  "properties": {
    "address": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300,
      "description": "A free-form street address to geocode."
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Optional ISO 3166-1 alpha-2 country hint."
    }
  }
}
